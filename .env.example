# ──────────────────────────────────────────
# 議事録AI 環境変数設定例
# このファイルを .env にコピーして値を編集してください
# ──────────────────────────────────────────

# ── Vertex AI / GCS（文字起こし・話者識別・議事録生成の LLM 呼び出しで使用）──

# GCP プロジェクト ID
GCP_PROJECT=your-gcp-project-id

# Vertex AI のリージョン
GCP_LOCATION=global

# 音声アップロード用の GCS バケット名（本アプリ専用に作成する。
# バケット名は GCP 全体で一意である必要がある）
GCS_BUCKET=your-gcs-bucket-name

# 文字起こし・話者識別・議事録生成に使う Gemini モデル
GEMINI_MODEL=gemini-2.5-flash

# サービスアカウント鍵 JSON のコンテナ内パス。docker-compose.yml で
# ./gcp/service-account.json を同じパスにマウントする
GOOGLE_APPLICATION_CREDENTIALS=/secrets/service-account.json

# 公開ポート（既定: 8000）
PORT=8000

# コンテナのタイムゾーン（既定: Asia/Tokyo）
TZ=Asia/Tokyo
