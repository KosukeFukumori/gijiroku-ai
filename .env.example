# ──────────────────────────────────────────
# 議事録AI 環境変数設定例
# このファイルを .env にコピーして値を編集してください
# ──────────────────────────────────────────

# ── ローカル文字起こし（mlx-whisper / Apple Silicon）────────────

# 文字起こしに使う mlx-whisper モデル（MLX 変換済みリポジトリ）。
# 日本語会議は large-v3 が高精度。速度優先なら turbo 系に変更可。
WHISPER_MODEL=mlx-community/whisper-large-v3-mlx

# 文字起こしの言語（空なら自動判定）。日本語会議は ja を推奨。
WHISPER_LANGUAGE=ja

# ── 話者識別（pyannote.audio）──────────────────────────────────

# HuggingFace アクセストークン。話者識別（誰が話したか）に必要。
# 未設定の場合は話者識別をスキップし文字起こしのみ行う。
# 事前に以下2つのモデルページで規約に同意しておくこと:
#   https://huggingface.co/pyannote/speaker-diarization-3.1
#   https://huggingface.co/pyannote/segmentation-3.0
HF_TOKEN=

# ── Vertex AI / Gemini（議事録生成の LLM 呼び出しで使用）────────

# GCP プロジェクト ID
GCP_PROJECT=your-gcp-project-id

# Vertex AI のリージョン
GCP_LOCATION=global

# 議事録生成に使う Gemini モデル
GEMINI_MODEL=gemini-2.5-flash

# サービスアカウント鍵 JSON のパス（ホスト上の絶対パス or 相対パス）
GOOGLE_APPLICATION_CREDENTIALS=./gcp/service-account.json

# タイムゾーン（既定: Asia/Tokyo）
TZ=Asia/Tokyo
